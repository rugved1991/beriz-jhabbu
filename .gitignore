# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/server/dist

# TypeScript build artifacts (generated files, not source)
*.d.ts
*.d.ts.map
*.js.map
# Exclude compiled JS files from src (only keep source .ts/.tsx)
src/**/*.js
src/**/*.d.ts
# Keep TypeScript source files
!src/**/*.ts
!src/**/*.tsx
!server/**/*.ts

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Server environment
server/.env
server/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db
